{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "按窗口职责授予插件与原生命令能力",
  "windows": [
    "textpreview*"
  ],
  "permissions": [
    "core:path:default",
    "core:window:default",
    "core:resources:default",
    "core:webview:allow-get-all-webviews",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-is-visible",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "dialog:default",
    "allow-show-panel",
    "allow-hide-panel",
    "allow-copy-text",
    "allow-copy-rich-clipboard",
    "allow-localize-rich-clipboard-images",
    "allow-get-target-snapshot",
    "allow-refresh-target-snapshot",
    "allow-validate-target-snapshot",
    "allow-send-delivery",
    "allow-scan-sensitive-text",
    "allow-scan-image-firewall",
    "allow-redact-delivery-image",
    "allow-cleanup-redacted-images",
    "allow-delivery-image-data-url",
    "allow-ax-trusted",
    "allow-tap-status",
    "allow-open-settings-window",
    "allow-get-vibrancy-enabled",
    "allow-list-send-targets",
    "allow-adopt-send-target",
    "allow-copy-image-to-clipboard",
    "allow-paste-images-from-clipboard",
    "allow-import-image-files",
    "allow-open-url",
    "allow-quick-look",
    "allow-hide-transient-image-preview",
    "allow-show-text-preview",
    "allow-ocr-image",
    "allow-prev-app-info",
    "allow-refresh-prev-app",
    "allow-show-capture-hud",
    "allow-hud-feedback",
    "allow-hide-hud",
    "allow-app-icon",
    "allow-app-list-info",
    "allow-diag-note",
    "allow-append-delivery-event",
    "allow-get-recent-delivery-events",
    "allow-get-data-dir",
    "allow-get-data-location-status",
    "allow-read-data-snapshot",
    "allow-image-data-url",
    "allow-image-thumb-url",
    "allow-export-notes-bundle",
    "allow-export-prompt-templates",
    "allow-get-ai-key-status",
    "allow-begin-ai-request",
    "allow-cancel-ai-request",
    "allow-authorize-ai-request",
    "allow-ai-chat",
    "allow-fetch-link-meta",
    "allow-fetch-favicon",
    "allow-fetch-exchange-rates",
    "allow-is-self-frontmost",
    "allow-edge-hide-now",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-preview-event"
  ]
}
