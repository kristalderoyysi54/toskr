{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "image-preview",
  "description": "按窗口职责授予插件与原生命令能力",
  "windows": [
    "imgpreview"
  ],
  "permissions": [
    "core:path:default",
    "core:window:default",
    "core:resources:default",
    "core:webview:allow-get-all-webviews",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-is-visible",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "allow-delivery-image-data-url",
    "allow-get-target-snapshot",
    "allow-image-data-url",
    "allow-image-thumb-url",
    "allow-copy-image-to-clipboard",
    "allow-paste-images-from-clipboard",
    "allow-import-image-files",
    "allow-open-url",
    "allow-diag-note",
    "allow-hud-feedback",
    "allow-hide-hud",
    "allow-get-data-dir",
    "allow-get-data-location-status",
    "allow-read-data-snapshot",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-preview-event"
  ]
}
