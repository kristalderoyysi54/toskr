{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "按窗口职责授予插件与原生命令能力",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:app:default",
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:resources:default",
    "core:webview:allow-get-all-webviews",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-is-visible",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-decorations",
    "dialog:default",
    "autostart:default",
    "updater:default",
    "process:allow-restart",
    "allow-show-panel",
    "allow-hide-panel",
    "allow-open-url",
    "allow-open-settings-window",
    "allow-ax-trusted",
    "allow-tap-status",
    "allow-retry-tap",
    "allow-restart-app",
    "allow-open-privacy-settings",
    "allow-reset-input-monitoring",
    "allow-set-new-note-hotkey",
    "allow-set-panel-hotkey",
    "allow-set-ai-api-key",
    "allow-get-ai-key-status",
    "allow-delete-ai-api-key",
    "allow-begin-ai-request",
    "allow-cancel-ai-request",
    "allow-authorize-ai-request",
    "allow-ai-chat",
    "allow-ai-list-models",
    "allow-detect-running-im-candidates",
    "allow-set-message-watch-auto",
    "allow-set-message-watch",
    "allow-get-message-watch-status",
    "allow-get-message-watch-bridge-info",
    "allow-get-message-watch-captures",
    "allow-copy-text",
    "allow-prev-app-info",
    "allow-bundle-id-of-app",
    "allow-app-list-info",
    "allow-app-icon",
    "allow-get-target-snapshot",
    "allow-refresh-target-snapshot",
    "allow-validate-target-snapshot",
    "allow-refresh-prev-app",
    "allow-get-data-dir",
    "allow-get-data-location-status",
    "allow-inspect-data-location",
    "allow-default-auto-backup-dir",
    "allow-get-diagnostics",
    "allow-diag-note",
    "allow-image-data-url",
    "allow-image-thumb-url",
    "allow-scan-sensitive-text",
    "allow-scan-image-firewall",
    "allow-delivery-image-data-url",
    "allow-hud-feedback",
    "allow-hide-hud",
    "allow-read-data-snapshot",
    "allow-get-recent-delivery-events",
    "allow-clear-delivery-events",
    "allow-append-delivery-event",
    "allow-inspect-media-integrity",
    "allow-inspect-backup",
    "allow-fetch-exchange-rates"
  ]
