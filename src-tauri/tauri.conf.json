{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toskr",
  "version": "0.19.9",
  "identifier": "com.toskr.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Toskr",
        "width": 380,
        "height": 700,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "settings",
        "title": "Toskr 设置",
        "width": 1040,
        "height": 720,
        "minWidth": 560,
        "minHeight": 420,
        "visible": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "hud",
        "title": "Toskr HUD",
        "width": 264,
        "height": 100,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "sourceoverlay",
        "title": "Toskr 来源",
        "width": 316,
        "height": 144,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "locatehl",
        "title": "Toskr 定位",
        "width": 260,
        "height": 76,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "textpreview",
        "title": "内容详情",
        "width": 560,
        "height": 540,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "minWidth": 380,
        "minHeight": 300
      },
      {
        "label": "imgpreview",
        "title": "图片预览",
        "width": 600,
        "height": 400,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "minWidth": 240,
        "minHeight": 180
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Toskr Dev Signing",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 180
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzM0YwQjU2MDcwRUM5MzYKUldRMnlRNEhWZ3MvUXdwM2svc2RTcVpkcnlaV08zaXZ2UThPVjAvdncwVW1pRDRtbWoxOVUwSW4K",
      "endpoints": [
        "https://github.com/kristalderoyysi54/toskr/releases/latest/download/latest.json"
      ]
    }
  }
}
